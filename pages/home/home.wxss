/* pages/home/home.wxss */
@font-face {
  font-family: "HarmonyOS Sans";
  src: url("/ttf/HarmonyOS Sans.ttf");
  font-family: "Alimama FangYuanTi VF";
  src: url("/ttf/Alimama FangYuanTi VF.ttf");
}
.bg-image {
  position: absolute;
  width: 438px;
  height: 1055.54px;

  top: -19.57px;
  left: -16px;
  z-index: 0;

  background-image: url('/images/bg.png');
  background-size: cover;
  background-position: center;
}

.home-page { min-height: 100vh; background-color: #1a1a2e; padding-top: 80rpx;}
.moon-logo {
  position: absolute;
  width: 30px;
  height: 29px;
  top: 90rpx;
  left: 18px;
  mix-blend-mode: normal;
}
.search-bar {
  position: absolute;

  width: 177px;
  height: 26px;
  left: 77px;

  display: flex;
  align-items: center;

  border-radius: 24rpx;

  padding: 0 8px; /* ⚠️ 这里建议缩小，否则会撑爆26px */
  box-sizing: border-box;

  z-index: 10;
  background-color: rgba(255, 251, 246, 0.5);
}
.search-icon-wrap {  margin-left: 10px; }

.search-input {  flex: 1;
  width: 100%;
  min-width: 0;
  color: rgba(255, 251, 246, 0.5); font-size: 24rpx; 
   padding-right: 20px; 
   font-family: "HarmonyOS Sans";
   font-weight: 250;
   font-size: 10px;
   line-height: 12px;
   letter-spacing: 0;
   text-align: left;}
.search-icon {
    position: relative;
    right: -20px;
    width: 16px;
    height: 16px;
  }
.search-placeholder { color: #8e8e9a; }
.search-more { padding: 0 16rpx; }

.content-scroll { height: calc(100vh - 100rpx); padding-top: 60px;} /* TabBar 50px */

/* 区块 */
.section { margin-bottom: 24rpx; }
.section-header { padding: 16rpx 32rpx 16rpx; }
.section-title {font-family: "Alimama FangYuanTi VF";
  font-weight: 700;

  font-size: 18px;
  line-height: 22px;

  letter-spacing: 0;
  text-align: left; color:rgba(255, 255, 255, 1)}

/* 计划横向滚动 */
.plan-scroll { white-space: nowrap; }
.plan-cards { display: flex; padding: 0 32rpx; gap: 16rpx; }

/* 计划卡片 */
.plan-card {
  width: 580rpx;
  background-color: #2d2d44;
  border-radius: 24rpx; /* 12px */
  overflow: hidden; flex-shrink: 0;
}
.plan-cover { position: relative; height: 320rpx; }
.plan-cover-placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, #2d3a4a, #1a2636); display: flex; align-items: center; justify-content: center; }
.central-asia-cover { background: linear-gradient(135deg, #3a2d2d, #36261a); }
.cover-icon { font-size: 72rpx; }
.plan-price-tag { position: absolute; top: 16rpx; left: 16rpx; background-color: #ff6b6b; padding: 4rpx 12rpx; border-radius: 8rpx; }
.price-text { font-size: 24rpx; color: #ffffff; font-weight: bold; }

.plan-tags { padding: 12rpx 16rpx 0; display: flex; flex-wrap: wrap; gap: 8rpx; }
.plan-desc { padding: 8rpx 16rpx; }
.desc-text { font-size: 24rpx; color: #a0a0b0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; white-space: normal; }
.plan-footer { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 16rpx 16rpx; }
.plan-duration { font-size: 20rpx; color: #8e8e9a; }
.plan-rating { background-color: rgba(78,205,196,0.2); padding: 4rpx 12rpx; border-radius: 16rpx; }
.rating-text { font-size: 20rpx; color: #4ecdc4; font-weight: bold; }

/* 中亚游 */
.central-asia-card { width: auto; margin: 0 32rpx; }
.central-asia-footer { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 16rpx 16rpx; }
.login-now-btn { display: inline-flex; padding: 12rpx 32rpx; }
.login-now-text { font-size: 24rpx; color: #ffffff; }
.close-btn { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; }
.close-text { font-size: 32rpx; color: #8e8e9a; }

/* DIY */
.diy-card { margin: 0 32rpx; border-radius: 24rpx; overflow: hidden; position: relative; background: linear-gradient(135deg, #2d3a5a, #1a2636); }
.diy-bg { height: 224rpx; display: flex; align-items: center; justify-content: center; }
.diy-bg-icon { font-size: 72rpx; }
.diy-content { padding: 0 32rpx 32rpx; }
.diy-desc { font-size: 24rpx; color: #a0a0b0; margin-bottom: 16rpx; line-height: 1.6; }
.diy-btn { display: inline-flex; padding: 12rpx 32rpx; border: 2rpx solid rgba(255,255,255,0.3); border-radius: 24rpx; }
.diy-btn-text { font-size: 24rpx; color: #ffffff; }

/* 弹窗 */
.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0,0,0,0.6); z-index: 1000; display: flex; align-items: center; justify-content: center; }
.modal-content { width: 544rpx; background-color: #2d2d44; border-radius: 24rpx; padding: 40rpx; text-align: center; }
.modal-title { font-size: 36rpx; color: #ffffff; font-weight: bold; display: block; margin-bottom: 16rpx; }
.modal-desc { font-size: 28rpx; color: #8e8e9a; display: block; margin-bottom: 32rpx; }
.modal-btns { display: flex; gap: 16rpx; }
.modal-cancel { flex: 1; padding: 20rpx 0; }
.modal-confirm { flex: 1; padding: 20rpx 0; }
