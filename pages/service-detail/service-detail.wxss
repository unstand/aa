/* pages/service-detail/service-detail.wxss */
.detail-page { min-height: 100vh; background-color: #1a1a2e; }
.content-scroll { height: calc(100vh - 100rpx); padding: 16rpx 32rpx; }

.product-section { margin-bottom: 16rpx; }
.product-main { display: flex; margin-bottom: 16rpx; }
.product-img-wrap { width: 208rpx; height: 160rpx; border-radius: 16rpx; overflow: hidden; margin-right: 16rpx; flex-shrink: 0; }
.product-img-placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, #3d3d5c, #2d2d44); display: flex; align-items: center; justify-content: center; }
.product-icon { font-size: 64rpx; }
.product-info { flex: 1; }
.product-title-row { display: flex; align-items: center; gap: 8rpx; margin-bottom: 8rpx; }
.product-name { font-size: 28rpx; color: #ffffff; font-weight: bold; }
.dropdown-icon { font-size: 20rpx; color: #4ecdc4; }
.product-items { font-size: 20rpx; color: #a0a0b0; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

.quantity-price-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.quantity-selector { display: flex; align-items: center; gap: 16rpx; }
.btn-minus, .btn-plus { width: 48rpx; height: 48rpx; border-radius: 50%; background-color: #3d3d5c; color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 32rpx; }
.btn-minus.disabled { opacity: 0.3; }
.quantity-value { font-size: 32rpx; color: #ffffff; font-weight: bold; min-width: 40rpx; text-align: center; }
.unit-price { font-size: 32rpx; color: #ff6b6b; font-weight: bold; }

.date-section { background-color: #232340; border-radius: 16rpx; padding: 16rpx; margin-bottom: 16rpx; }
.date-row { display: flex; align-items: center; justify-content: space-between; }
.date-item { flex: 1; }
.date-label { font-size: 20rpx; color: #8e8e9a; display: block; margin-bottom: 4rpx; }
.date-value { font-size: 24rpx; color: #4ecdc4; }
.date-duration { padding: 4rpx 12rpx; background-color: rgba(78,205,196,0.15); border-radius: 16rpx; }
.duration-text { font-size: 20rpx; color: #4ecdc4; }

.location-section { background-color: #232340; border-radius: 16rpx; padding: 12rpx 16rpx; }
.location-row { display: flex; align-items: center; padding: 8rpx 0; }
.location-label { font-size: 24rpx; color: #8e8e9a; width: 112rpx; }
.location-value { font-size: 24rpx; color: #ffffff; }

/* 套餐 */
.package-section { margin-bottom: 16rpx; }
.section-title { font-size: 28rpx; color: #ffffff; font-weight: bold; margin-bottom: 16rpx; display: block; }
.package-options { display: flex; gap: 16rpx; }
.package-card { flex: 1; background-color: #232340; border: 2rpx solid transparent; border-radius: 16rpx; padding: 16rpx; text-align: center; }
.package-card.selected { border-color: #4ecdc4; background-color: rgba(78,205,196,0.05); }
.package-name { font-size: 24rpx; color: #ffffff; font-weight: bold; display: block; margin-bottom: 8rpx; }
.package-price-add { font-size: 24rpx; color: #4ecdc4; display: block; margin-bottom: 8rpx; }
.package-items { font-size: 20rpx; color: #8e8e9a; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

/* 使用须知 */
.notice-section { margin-bottom: 16rpx; }
.notice-header { margin-bottom: 16rpx; }
.notice-underline { height: 3rpx; width: 112rpx; background-color: #4ecdc4; margin-top: 8rpx; }
.notice-content { background-color: #232340; border-radius: 16rpx; padding: 24rpx; }
.notice-img-placeholder { display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.notice-icon { font-size: 56rpx; }
.notice-text { font-size: 24rpx; color: #8e8e9a; text-align: center; }

.safe-bottom { height: 120rpx; }

.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; align-items: center; padding: 16rpx 32rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); background-color: #1e1e32; z-index: 100; }
.price-info { flex: 1; }
.price-label { font-size: 24rpx; color: #8e8e9a; }
.price-value { font-size: 40rpx; color: #ff6b6b; font-weight: bold; }
.action-btns { display: flex; gap: 16rpx; }
.btn { padding: 16rpx 32rpx; border-radius: 24rpx; font-size: 28rpx; font-weight: bold; white-space: nowrap; color: #ffffff; }
.btn-contact { background-color: #3d5a80; }
.btn-action { background: linear-gradient(135deg, #4ecdc4, #44a08d); }
