/* pages/service/service.wxss */
.service-page { min-height: 100vh; background-color: #1a1a2e; }

.search-bar {
  position: absolute;

  width: 177px;
  height: 26px;
  top: 45px;
  left: 77px;

  display: flex;
  align-items: center;

  border-radius: 24rpx;

  padding: 0 8px; /* ⚠️ 这里建议缩小，否则会撑爆26px */
  box-sizing: border-box;

  z-index: 10;
  background-color: rgba(255, 251, 246, 0.5);
}
.search-icon-wrap {  margin-left: 10px; }

.search-input {  flex: 1;
  width: 100%;
  min-width: 0;
  color: rgba(255, 251, 246, 0.5); font-size: 24rpx; 
   padding-right: 20px; 
   font-family: "HarmonyOS Sans";
   font-weight: 250;
   font-size: 10px;
   line-height: 12px;
   letter-spacing: 0;
   text-align: left;}
.search-icon {
    position: relative;
    right: -20px;
  color: #ff6b6b;
    width: 16px;
    height: 16px;
  }
.search-placeholder { color: #8e8e9a; }
.search-more { padding: 0 16rpx; }

.main-content { display: flex; height: calc(100vh - 100rpx); padding-top: 120px;}

.category-sidebar { width: 176rpx; background-color: #232340; height: 100%; }
.category-item { padding: 24rpx 16rpx; text-align: center; position: relative; }
.category-item.active { background-color: #2d2d44; }
.cat-name { display: block; font-size: 20rpx; color: #8e8e9a; margin-bottom: 8rpx; }
.category-item.active .cat-name { color: #ffffff; font-weight: bold; }
.cat-price { display: block; font-size: 20rpx; color: #ffd93d; }
.cat-underline { position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 6rpx; height: 40rpx; background-color: #4ecdc4; border-radius: 3rpx; }

.service-list { flex: 1; height: 100%; padding: 0 16rpx; }
.service-card { display: flex; background-color: #2d2d44; border-radius: 24rpx; padding: 16rpx; margin-bottom: 16rpx; }
.service-img { width: 176rpx; height: 176rpx; border-radius: 16rpx; overflow: hidden; margin-right: 16rpx; flex-shrink: 0; }
.service-img-placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, #3d3d5c, #2d2d44); display: flex; align-items: center; justify-content: center; }
.service-icon { font-size: 56rpx; }
.service-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.service-header { margin-bottom: 8rpx; }
.service-edition-tag { display: inline-block; background-color: rgba(78,205,196,0.2); padding: 4rpx 12rpx; border-radius: 8rpx; }
.edition-text { font-size: 20rpx; color: #4ecdc4; font-weight: bold; }
.service-items { font-size: 20rpx; color: #a0a0b0; margin-bottom: 4rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.service-dimensions { font-size: 20rpx; color: #8e8e9a; margin-bottom: 4rpx; }
.service-price { font-size: 28rpx; color: #ff6b6b; font-weight: bold; align-self: flex-end; }

.empty-state { display: flex; align-items: center; justify-content: center; height: 400rpx; }
.empty-text { font-size: 28rpx; color: #8e8e9a; }
