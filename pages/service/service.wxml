<!--pages/service/service.wxml-->
<view class="service-page">
  <!-- 顶部搜索栏 -->
  <view class="search-bar">
    <view class="search-inner">
      <input 
        class="search-input" 
        placeholder="你在找什么服务？" 
        placeholder-class="search-placeholder" 
        bindinput="onSearchInput" 
        value="{{searchKeyword}}" 
      />
      <image class="search-icon" src="/images/sousuo.png" mode="aspectFit" />
    </view>
    <view class="search-more" bindtap="onMoreMenu">
      <view class="more-dots">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
    </view>
  </view>

  <!-- 主体内容 -->
  <view class="main-content">
    <!-- 左侧分类导航 -->
    <scroll-view scroll-y class="category-sidebar" enhanced show-scrollbar="{{false}}">
      <view class="category-item {{activeCategory === index ? 'active' : ''}}" 
            wx:for="{{categories}}" wx:key="index" 
            bindtap="onCategoryTap" data-index="{{index}}">
        <text class="cat-name">{{item.name}}</text>
        <text class="cat-price">¥{{item.price}}起</text>
        <view class="cat-indicator" wx:if="{{activeCategory === index}}"></view>
      </view>
    </scroll-view>

    <!-- 右侧服务列表 -->
    <scroll-view scroll-y class="service-list" enhanced show-scrollbar="{{false}}">
      <view class="service-card" wx:for="{{filteredServices}}" wx:key="id" bindtap="onServiceTap" data-id="{{item.id}}">
        <!-- 服务图片 -->
        <view class="service-img">
          <view class="service-img-placeholder">
            <text class="service-icon">🎒</text>
          </view>
          <!-- 右上角音乐图标 -->
          <view class="music-badge">
            <text class="music-icon">♪</text>
          </view>
        </view>
        <!-- 服务信息 -->
        <view class="service-info">
          <text class="service-title">{{item.name}} {{item.edition}} {{item.forCount}}</text>
          <text class="service-items">{{item.items}}</text>
          <text class="service-dimensions">尺寸：{{item.dimensions}}</text>
          <text class="service-price">¥{{item.price}}/{{item.unit}}</text>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{filteredServices.length === 0}}">
        <text class="empty-text">暂无该类别服务</text>
      </view>
      <view class="list-bottom-space"></view>
    </scroll-view>
  </view>
</view>
