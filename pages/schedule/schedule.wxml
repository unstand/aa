<view class="schedule-page">
  <image class="page-bg" src="/images/邀请长图（新疆自驾） 1.png" mode="aspectFill"></image>
  <view class="page-mask"></view>
  <view class="top-tools"></view>
  <view class="profile">
    <text class="user-name">{{user.name}}</text>
    <text class="user-id">ID：{{user.id}}</text>
  </view>
  <view class="tabs">
    <view class="tab-item active">
      <text>我的计划</text>
    </view>
    <view class="tab-item" bindtap="onContactUs">
      <text>联系我们</text>
    </view>
  </view>
  <scroll-view class="plan-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view
      class="plan-card"
      wx:for="{{plans}}"
      wx:key="id"
      bindtap="onPlanTap"
      data-id="{{item.id}}"
    >
      <view class="cover-wrap">
        <image class="cover-image" src="{{item.cover}}" mode="aspectFill"></image>
        <view class="cover-mask"></view>
        <view class="lock">
          <view class="lock-ring"></view>
          <view class="lock-body"></view>
        </view>
        <text class="cover-title">{{item.title}}</text>
      </view>
      <view class="card-content">
        <view class="price-pill">
          <text>{{item.price}}</text>
        </view>
        <view class="tag-row">
          <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
        <view class="detail-list">
          <text class="detail-line">预定时间：{{item.bookDate}}</text>
          <text class="detail-line">计划日期：{{item.startDate}} 至{{item.endDate}}</text>
          <text class="detail-line">出发地点：{{item.departure}}</text>
          <text class="detail-line">车型：{{item.vehicle}}</text>
        </view>
        <view class="action-row">
          <view class="action-btn ghost" catchtap="onViewPlan" data-id="{{item.id}}">
            <text>查看计划</text>
          </view>
          <view class="action-btn ghost" catchtap="onViewContract" data-id="{{item.id}}">
            <text>查看合同</text>
          </view>
          <view class="action-btn primary" catchtap="onBookNow" data-id="{{item.id}}">
            <text>立即预定</text>
          </view>
        </view>
      </view>
    </view>
    <view class="empty-space"></view>
  </scroll-view>
</view>