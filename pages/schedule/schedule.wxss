.cover-title {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  bottom: 18rpx;
  font-size: 22rpx;
  line-height: 28rpx;
  color: #ffffff;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.card-content {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 16rpx 12rpx 12rpx 16rpx;
  box-sizing: border-box;
}
.price-pill {
  position: absolute;
  top: 6rpx;
  left: -320rpx;
  min-width: 142rpx;
  height: 28rpx;
  padding: 0 12rpx;
  border-radius: 14rpx;
  background: rgba(27, 31, 36, 0.58);
  border: 1rpx solid rgba(255, 255, 255, 0.36);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.price-pill text {
  font-size: 13rpx;
  color: rgba(255, 255, 255, 0.88);
}
.tag-row {
  position: absolute;
  left: -316rpx;
  bottom: 10rpx;
  display: flex;
  gap: 8rpx;
}
.tag {
  min-width: 62rpx;
  height: 24rpx;
  padding: 0 8rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.52);
  background: rgba(28, 32, 36, 0.52);
  color: rgba(255, 255, 255, 0.84);
  font-size: 13rpx;
  line-height: 24rpx;
  text-align: center;
  box-sizing: border-box;
}
.detail-list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding-left: 2rpx;
}
.detail-line {
  font-size: 14rpx;
  line-height: 20rpx;
  color: rgba(255, 255, 255, 0.76);
  white-space: nowrap;
}
.action-row {
  position: absolute;
  left: 16rpx;
  right: 12rpx;
  bottom: 10rpx;
  display: flex;
  justify-content: flex-end;
  gap: 8rpx;
}
.action-btn {
  min-width: 84rpx;
  height: 30rpx;
  padding: 0 10rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.action-btn text {
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.88);
  white-space: nowrap;
}
.action-btn.ghost {
  border: 1rpx solid rgba(255, 255, 255, 0.48);
  background: rgba(255, 255, 255, 0.06);
}
.action-btn.primary {
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  background: rgba(255, 255, 255, 0.16);
}
.empty-space {
  height: calc(120rpx + env(safe-area-inset-bottom));
}