/* pages/contract/contract.wxss */
.contract-page { min-height: 100vh; background-color: #1a1a2e; }
.content-scroll { height: calc(100vh - 100rpx); padding: 16rpx 32rpx; }

/* 合同标题 */
.contract-header { text-align: center; padding: 24rpx 0 32rpx; }
.contract-title { font-size: 40rpx; color: #ffffff; font-weight: bold; letter-spacing: 4rpx; }

/* 区块 */
.section { margin-bottom: 16rpx; background-color: #2d2d44; border-radius: 24rpx; padding: 16rpx; }
.section-label { font-size: 28rpx; color: #4ecdc4; font-weight: bold; display: block; margin-bottom: 16rpx; }
.section-subtitle { font-size: 28rpx; color: #4ecdc4; font-weight: bold; display: block; margin-bottom: 16rpx; }

/* 表单 */
.form-group { display: flex; flex-direction: column; gap: 12rpx; }
.form-row { display: flex; align-items: center; gap: 8rpx; }
.form-label { font-size: 24rpx; color: #a0a0b0; white-space: nowrap; min-width: 160rpx; }
.form-input { flex: 1; font-size: 24rpx; color: #ffffff; background-color: #232340; border-radius: 8rpx; padding: 8rpx 12rpx; border: 1rpx solid rgba(255,255,255,0.08); }
.info-row { display: flex; align-items: baseline; gap: 8rpx; }
.info-value { font-size: 24rpx; color: #ffffff; flex: 1; }
.date-text { font-size: 24rpx; color: #a0a0b0; flex: 1; }

/* 费用 */
.fee-row { display: flex; align-items: baseline; gap: 8rpx; margin-bottom: 12rpx; }
.fee-value { font-size: 28rpx; color: #ff6b6b; font-weight: bold; flex: 1; }
.fee-detail { margin-bottom: 8rpx; }
.fee-detail-label { font-size: 20rpx; color: #a0a0b0; display: block; margin-bottom: 4rpx; }
.fee-detail-text { font-size: 20rpx; color: #8e8e9a; line-height: 1.6; }

/* 权利义务 */
.rights-section { margin-bottom: 16rpx; }
.rights-title { font-size: 24rpx; color: #ffd93d; font-weight: bold; display: block; margin-bottom: 8rpx; }
.rights-list { display: flex; flex-direction: column; gap: 8rpx; }
.rights-item { display: flex; align-items: flex-start; gap: 8rpx; }
.rights-bullet { font-size: 24rpx; color: #4ecdc4; line-height: 1.6; }
.rights-text { font-size: 24rpx; color: #a0a0b0; line-height: 1.6; flex: 1; }

/* 协议 */
.agreement-section { margin: 16rpx 0; padding: 16rpx; }
.agreement-row { display: flex; align-items: center; gap: 12rpx; }
.checkbox { width: 32rpx; height: 32rpx; border: 2rpx solid rgba(255,255,255,0.3); border-radius: 4rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: all 0.3s; }
.checkbox.checked { background-color: #4ecdc4; border-color: #4ecdc4; }
.checkbox-icon { font-size: 20rpx; color: #ffffff; font-weight: bold; }
.agreement-text { font-size: 24rpx; color: #a0a0b0; }

.safe-bottom { height: 120rpx; }

.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; align-items: center; padding: 16rpx 32rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); background-color: #1e1e32; z-index: 100; }
.price-info { flex: 1; }
.price-label { font-size: 24rpx; color: #8e8e9a; }
.price-value { font-size: 40rpx; color: #ff6b6b; font-weight: bold; }
.action-btns { display: flex; gap: 16rpx; }
.btn { padding: 16rpx 32rpx; border-radius: 24rpx; font-size: 28rpx; font-weight: bold; white-space: nowrap; color: #ffffff; }
.btn-contact { background-color: #3d5a80; }
.btn-action { background: linear-gradient(135deg, #4ecdc4, #44a08d); }
