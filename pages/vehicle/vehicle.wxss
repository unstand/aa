/* pages/vehicle/vehicle.wxss */
.vehicle-page {
  min-height: 100vh;
  background-color: #1a1a2e;
  display: flex;
  flex-direction: column;
}

/* ===== 搜索栏 ===== */
.search-bar {
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  padding-top: calc(88rpx + env(safe-area-inset-top));
  padding-bottom: 20rpx;
  z-index: 10;
}

.search-inner {
  flex: 1;
  display: flex;
  align-items: center;
  height: 52rpx;
  background-color: rgba(255, 251, 246, 0.12);
  border-radius: 26rpx;
  padding: 0 20rpx;
}

.search-input {
  flex: 1;
  font-size: 22rpx;
  color: #ffffff;
  font-family: "HarmonyOS Sans";
  font-weight: 300;
  min-width: 0;
}

.search-placeholder {
  color: rgba(255, 255, 255, 0.4);
  font-size: 22rpx;
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  margin-left: 12rpx;
  opacity: 0.6;
  flex-shrink: 0;
}

.search-more {
  margin-left: 16rpx;
  padding: 8rpx;
}

.more-dots {
  display: flex;
  gap: 6rpx;
}

.dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.5);
}

/* ===== 主体 ===== */
.main-content {
  display: flex;
  flex: 1;
  height: calc(100vh - 180rpx);
}

/* ===== 左侧分类 ===== */
.category-sidebar {
  width: 176rpx;
  background-color: rgba(35, 35, 64, 0.6);
  height: 100%;
  flex-shrink: 0;
}

.category-item {
  padding: 28rpx 16rpx;
  text-align: center;
  position: relative;
  transition: background-color 0.2s;
}

.category-item.active {
  background-color: rgba(45, 45, 68, 0.8);
}

.cat-name {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.45);
  margin-bottom: 8rpx;
  font-family: "HarmonyOS Sans";
}

.category-item.active .cat-name {
  color: #ffffff;
  font-weight: 600;
  font-size: 24rpx;
}

.cat-price {
  display: block;
  font-size: 18rpx;
  color: rgba(255, 217, 61, 0.7);
  font-family: "HarmonyOS Sans";
}

.category-item.active .cat-price {
  color: #ffd93d;
}

.cat-indicator {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 44rpx;
  background-color: #4ecdc4;
  border-radius: 0 3rpx 3rpx 0;
}

/* ===== 右侧车辆列表 ===== */
.vehicle-list {
  flex: 1;
  height: 100%;
  padding: 0 20rpx;
}

.vehicle-card {
  display: flex;
  background-color: rgba(45, 45, 68, 0.7);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  backdrop-filter: blur(10px);
}

/* 车辆图片 */
.vehicle-img {
  width: 200rpx;
  height: 160rpx;
  border-radius: 14rpx;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
  position: relative;
}

.vehicle-img-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(145deg, #3d3d5c, #2a2a44);
  display: flex;
  align-items: center;
  justify-content: center;
}

.vehicle-icon {
  font-size: 64rpx;
  opacity: 0.6;
}

.video-badge {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(78, 205, 196, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-icon {
  font-size: 18rpx;
  color: #ffffff;
}

/* 车辆信息 */
.vehicle-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.vehicle-name {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 600;
  margin-bottom: 8rpx;
  font-family: "HarmonyOS Sans";
}

.vehicle-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.vtag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  background-color: rgba(142, 142, 154, 0.2);
  color: rgba(255, 255, 255, 0.65);
  font-family: "HarmonyOS Sans";
}

.vehicle-specs {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.55);
  margin-bottom: 6rpx;
  line-height: 1.4;
}

.vehicle-features {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-bottom: 8rpx;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.vehicle-price {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 700;
  align-self: flex-end;
  font-family: "HarmonyOS Sans";
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}

.empty-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
}

.list-bottom-space {
  height: 40rpx;
}
