/* pages/vehicle/vehicle.wxss */
.vehicle-page { min-height: 100vh; background-color: #1a1a2e; }

.search-bar {
  position: absolute;

  width: 177px;
  height: 26px;
  top: 45px;
  left: 77px;

  display: flex;
  align-items: center;

  border-radius: 24rpx;

  padding: 0 8px; /* ⚠️ 这里建议缩小，否则会撑爆26px */
  box-sizing: border-box;

  z-index: 10;
  background-color: rgba(255, 251, 246, 0.5);
}
.search-icon-wrap {  margin-left: 10px; }

.search-input {  flex: 1;
  width: 100%;
  min-width: 0;
  color: rgba(255, 251, 246, 0.5); font-size: 24rpx; 
   padding-right: 20px; 
   font-family: "HarmonyOS Sans";
   font-weight: 250;
   font-size: 10px;
   line-height: 12px;
   letter-spacing: 0;
   text-align: left;}
.search-icon {
    position: relative;
    right: -20px;
    width: 16px;
    height: 16px;
  }
.search-placeholder { color: #8e8e9a; }
.search-more { padding: 0 16rpx; }
/* 主体 */
.main-content { display: flex; height: calc(100vh - 100rpx); padding-top: 120px;} /* 扣TabBar */

/* 左侧分类 - 16px=32rpx边距 */
.category-sidebar { width: 176rpx; background-color: #232340; height: 100%; }
.category-item { padding: 24rpx 16rpx; text-align: center; position: relative; }
.category-item.active { background-color: #2d2d44; }
.cat-name { display: block; font-size: 24rpx; color: #8e8e9a; margin-bottom: 8rpx; }
.category-item.active .cat-name { color: #ffffff; font-weight: bold; }
.cat-price { display: block; font-size: 20rpx; color: #ffd93d; }
.cat-underline { position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 6rpx; height: 40rpx; background-color: #4ecdc4; border-radius: 3rpx; }

/* 右侧车辆列表 */
.vehicle-list { flex: 1; height: 100%; padding: 0 16rpx; }
.vehicle-card { display: flex; background-color: #2d2d44; border-radius: 24rpx; padding: 16rpx; margin-bottom: 16rpx; }
.vehicle-img { width: 192rpx; height: 144rpx; border-radius: 16rpx; overflow: hidden; margin-right: 16rpx; flex-shrink: 0; }
.vehicle-img-placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, #3d3d5c, #2d2d44); display: flex; align-items: center; justify-content: center; }
.vehicle-icon { font-size: 56rpx; }
.vehicle-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.vehicle-name { font-size: 28rpx; color: #ffffff; font-weight: bold; margin-bottom: 4rpx; }
.vehicle-specs { font-size: 20rpx; color: #a0a0b0; margin-bottom: 4rpx; }
.vehicle-features { font-size: 20rpx; color: #8e8e9a; margin-bottom: 8rpx; }
.vehicle-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 8rpx; }
.vehicle-price { font-size: 28rpx; color: #ff6b6b; font-weight: bold; }

/* 空状态 */
.empty-state { display: flex; align-items: center; justify-content: center; height: 400rpx; }
.empty-text { font-size: 28rpx; color: #8e8e9a; }
